{
  "name": "alphaine-lexi-language",
  "version": "1.0.0-prebuild.260908-dv13",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:github-pages": "vite build --config vite.github-pages.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit --incremental false",
    "dv12:build-indexes": "node scripts/build-dv12-indexes.mjs",
    "audit:cleanup": "node scripts/audit-runtime-cleanup.mjs",
    "test:dv12": "node --import tsx --test tests/dv12.test.ts",
    "benchmark:dv12": "node --import tsx scripts/run-dv12-evaluation.mjs",
    "benchmark:dv12:performance": "node --import tsx scripts/run-dv12-performance.mjs",
    "dv12:validate": "node --import tsx scripts/validate-dv12.mjs",
    "gate:dv12:rc": "node --import tsx scripts/run-dv12-evaluation.mjs --rc",
    "budget:dv12": "node scripts/check-dv12-budget.mjs",
    "verify:dv12": "npm run typecheck && npm run audit:cleanup && npm run dv12:validate && npm run build && npm run budget:dv12 && npm run test:dv12 && npm run benchmark:dv12 && npm run benchmark:dv12:performance",
    "test:unit": "node --import tsx --test tests/*.test.*",
    "test": "npm run typecheck && npm run build && npm run test:unit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --max-warnings=0",
    "test:dv13": "node --import tsx --test tests/dv13.test.ts",
    "benchmark:dv13": "node --import tsx scripts/run-dv13-evaluation.mjs",
    "gate:dv13:rc": "node --import tsx scripts/run-dv13-evaluation.mjs --rc",
    "feedback:dv13:stage": "node --import tsx scripts/review-dv13-feedback.mjs stage",
    "feedback:dv13:admit": "node --import tsx scripts/review-dv13-feedback.mjs admit",
    "dv13:validate": "node --import tsx scripts/validate-dv13-release.mjs",
    "budget:dv13": "node scripts/check-dv12-budget.mjs --dv13",
    "benchmark:dv13:performance": "node --import tsx scripts/run-dv12-performance.mjs --dv13",
    "verify:dv13": "npm run typecheck && npm run audit:cleanup && npm run dv12:validate && npm run dv13:validate && npm run build && npm run budget:dv13 && npm run test:unit && npm run benchmark:dv13 && npm run benchmark:dv13:performance"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
