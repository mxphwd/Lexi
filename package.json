{
  "name": "alphaine-lexi-language",
  "version": "1.0.0-prebuild.260811-dv10",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import tsx --test tests/*.test.*",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "corpus:generate": "node scripts/generate-example-contexts.mjs",
    "corpus:generate-basic": "node scripts/generate-basic-conversations.mjs",
    "corpus:generate-daily": "node scripts/generate-daily-life-contexts.mjs",
    "corpus:inventory": "node scripts/build-context-inventory.mjs",
    "corpus:validate": "node scripts/validate-corpus.mjs",
    "lexicon:build": "node scripts/build-lexicon-index.mjs",
    "dv9:build-data": "node scripts/build-dv9-data-pack.mjs",
    "dv9:validate-data": "node scripts/validate-dv9-data-pack.mjs",
    "dv10:freeze-failures": "node --import tsx scripts/build-dv10-failure-benchmark.mjs",
    "benchmark:dv7": "node --import tsx scripts/run-dv7-benchmark.mjs",
    "benchmark:dv8": "node --import tsx scripts/run-dv8-benchmark.mjs",
    "benchmark:dv9": "node --import tsx scripts/run-dv9-benchmark.mjs",
    "benchmark:dv10": "node --import tsx scripts/run-dv10-benchmark.mjs"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
